---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';

const {
  title,
  description,
  image = '/images/og-default.svg',
  type = 'website',
  published,
  updated,
} = Astro.props;

const siteUrl = 'https://roamdawn.com';
const canonical = new URL(Astro.url.pathname, siteUrl).href;
const absoluteImage = new URL(image, siteUrl).href;
const isArticle = type === 'article';

const ld = {
  '@context': 'https://schema.org',
  '@type': isArticle ? 'BlogPosting' : 'WebSite',
  headline: isArticle ? title : undefined,
  name: 'RoamDawn',
  url: canonical,
  description,
  image: [absoluteImage],
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  ...(isArticle
    ? {
        datePublished: published,
        dateModified: updated || published,
        author: { '@type': 'Organization', name: 'RoamDawn Editorial Team', url: siteUrl },
        publisher: {
          '@type': 'Organization',
          name: 'RoamDawn',
          url: siteUrl,
          logo: { '@type': 'ImageObject', url: `${siteUrl}/images/og-default.svg` },
        },
      }
    : {
        potentialAction: {
          '@type': 'SearchAction',
          target: `${siteUrl}/search/?q={search_term_string}`,
          'query-input': 'required name=search_term_string',
        },
      }),
};
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#168ac0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow,max-image-preview:large" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={isArticle ? 'article' : 'website'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={absoluteImage} />
    <meta property="og:image:alt" content={title} />
    <meta property="og:site_name" content="RoamDawn" />
    {published && <meta property="article:published_time" content={published} />}
    {updated && <meta property="article:modified_time" content={updated} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteImage} />
    <meta name="twitter:image:alt" content={title} />
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  </head>
  <body>
    <a class="skip-link focus-ring" href="#main">Skip to content</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
    <CookieBanner />
  </body>
</html>
