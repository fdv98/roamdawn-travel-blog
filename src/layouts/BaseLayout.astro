---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';

const {
  title,
  description,
  image = '/images/og-default.svg',
  type = 'website',
  published,
  updated,
  breadcrumbs = [],
} = Astro.props;

const siteUrl = 'https://roamdawn.com';
const canonical = new URL(Astro.url.pathname, siteUrl).href;
const absoluteImage = new URL(image, siteUrl).href;
const isArticle = type === 'article';
const isHome = Astro.url.pathname === '/';

const breadcrumbItems = [
  { name: 'Home', url: `${siteUrl}/` },
  ...breadcrumbs.map((item) => ({ name: item.label, url: new URL(item.href, siteUrl).href })),
];

const graph = [
  {
    '@type': 'Organization',
    '@id': `${siteUrl}/#organization`,
    name: 'RoamDawn',
    url: siteUrl,
    logo: { '@type': 'ImageObject', url: `${siteUrl}/images/og-default.svg` },
  },
  isArticle
    ? {
        '@type': 'BlogPosting',
        '@id': `${canonical}#article`,
        headline: title,
        description,
        image: [absoluteImage],
        url: canonical,
        mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
        datePublished: published,
        dateModified: updated || published,
        author: { '@type': 'Organization', '@id': `${siteUrl}/#organization` },
        publisher: { '@type': 'Organization', '@id': `${siteUrl}/#organization` },
      }
    : {
        '@type': isHome ? 'WebSite' : 'WebPage',
        '@id': `${canonical}#page`,
        name: title,
        headline: title,
        description,
        url: canonical,
        image: [absoluteImage],
        isPartOf: { '@type': 'WebSite', '@id': `${siteUrl}/#website`, name: 'RoamDawn', url: siteUrl },
        ...(isHome
          ? {
              potentialAction: {
                '@type': 'SearchAction',
                target: `${siteUrl}/search/?q={search_term_string}`,
                'query-input': 'required name=search_term_string',
              },
            }
          : {}),
      },
  ...(breadcrumbs.length > 0
    ? [{
        '@type': 'BreadcrumbList',
        '@id': `${canonical}#breadcrumb`,
        itemListElement: breadcrumbItems.map((item, index) => ({
          '@type': 'ListItem',
          position: index + 1,
          name: item.name,
          item: item.url,
        })),
      }]
    : []),
];
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#168ac0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="RoamDawn RSS" href={`${siteUrl}/rss.xml`} />
    <meta property="og:type" content={isArticle ? 'article' : 'website'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={absoluteImage} />
    <meta property="og:image:alt" content={title} />
    <meta property="og:site_name" content="RoamDawn" />
    <meta property="og:locale" content="en_US" />
    {published && <meta property="article:published_time" content={published} />}
    {updated && <meta property="article:modified_time" content={updated} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteImage} />
    <meta name="twitter:image:alt" content={title} />
    <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': graph })} />
  </head>
  <body>
    <a class="skip-link focus-ring" href="#main">Skip to content</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
    <CookieBanner />
  </body>
</html>
