---
const {name,slug,description,image}=Astro.props;
---
<a href={`/destinations/${slug}/`} class="group block overflow-hidden rounded-2xl border border-sky-100 bg-white shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-lg">
  <div class="aspect-[16/9] overflow-hidden bg-[#f4fbfd]">
    {image ? <img src={image} alt={`${name} travel destination`} width="1200" height="675" loading="lazy" decoding="async" class="h-full w-full object-cover transition duration-500 group-hover:scale-105" /> : <div class="grid h-full place-items-center bg-[#f4fbfd] text-4xl font-black text-[#17324d]" aria-hidden="true">{name}</div>}
  </div>
  <div class="p-5"><h3 class="text-2xl font-black text-[#17324d]">{name}</h3><p class="mt-2 text-sm leading-6 text-slate-600">{description}</p><span class="mt-4 inline-block font-bold text-[#1596c2]">Explore {name} →</span></div>
</a>
