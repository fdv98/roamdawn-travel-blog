<div id="cookie-banner" class="fixed bottom-4 left-4 right-4 z-50 mx-auto hidden max-w-3xl rounded-2xl border border-stone-200 bg-white p-5 shadow-2xl" role="dialog" aria-label="Cookie preferences"><h2 class="font-black">Your privacy choices</h2><p class="mt-2 text-sm text-slate-600">Essential storage is used for preferences. Optional analytics and advertising should remain disabled until properly configured and, where required, consented to.</p><div class="mt-4 flex flex-wrap gap-2"><button id="cookie-accept" class="rounded-full bg-[#168ac0] px-5 py-2 font-bold text-white">Accept</button><button id="cookie-reject" class="rounded-full border px-5 py-2 font-bold">Reject non-essential</button></div></div><script is:inline>{`const b=document.getElementById('cookie-banner'),k='rd-consent';if(!localStorage.getItem(k))b?.classList.remove('hidden');document.getElementById('cookie-accept')?.addEventListener('click',()=>{localStorage.setItem(k,'accepted');b?.classList.add('hidden')});document.getElementById('cookie-reject')?.addEventListener('click',()=>{localStorage.setItem(k,'rejected');b?.classList.add('hidden')});document.getElementById('cookie-settings')?.addEventListener('click',()=>b?.classList.remove('hidden'));`}</script>
