---
import { destinations } from '../data/destinations';
const featuredDestinations = destinations;
---
<header class="site-header">
  <div class="header-inner container">
    <a href="/" class="site-logo focus-ring" aria-label="RoamDawn home"><span>Roam</span><b>Dawn</b></a>

    <nav class="desktop-nav" aria-label="Primary navigation">
      <a class="focus-ring" href="/blog/">Stories</a>
      <div class="nav-dropdown">
        <button type="button" class="focus-ring" aria-expanded="false" aria-controls="destinations-menu" data-menu-button="destinations-menu">Destinations <span aria-hidden="true">⌄</span></button>
        <div id="destinations-menu" class="dropdown-panel" data-menu-panel>
          <p class="dropdown-kicker">Explore destinations</p>
          <a href="/destinations/" class="dropdown-feature">All destinations</a>
          {featuredDestinations.map((destination) => <a href={`/destinations/${destination.slug}/`}>{destination.name}</a>)}
        </div>
      </div>
      <div class="nav-dropdown">
        <button type="button" class="focus-ring" aria-expanded="false" aria-controls="guides-menu" data-menu-button="guides-menu">Travel Guides <span aria-hidden="true">⌄</span></button>
        <div id="guides-menu" class="dropdown-panel guides-panel" data-menu-panel>
          <p class="dropdown-kicker">Travel library</p>
          <a href="/blog/">All Travel Guides</a>
          <a href="/tags/cities/">Cities</a>
          <a href="/itineraries/">Trip Planning</a>
          <a href="/tags/travel-planning/">Travel Planning</a>
        </div>
      </div>
      <a class="focus-ring" href="/tags/travel-planning/">Travel Tips</a>
      <a class="focus-ring" href="/about/">About</a>
      <a class="search-button focus-ring" href="/search/" aria-label="Search RoamDawn">⌕ <span>Search</span></a>
    </nav>

    <button id="nav-toggle" type="button" class="mobile-menu focus-ring" aria-expanded="false" aria-controls="mobile-nav" aria-label="Open navigation">Menu</button>
  </div>

  <div id="mobile-nav" class="mobile-nav" aria-hidden="true">
    <nav class="container" aria-label="Mobile navigation">
      <a href="/blog/">Stories</a>
      <button type="button" data-mobile-toggle="mobile-destinations" aria-expanded="false" aria-controls="mobile-destinations">Destinations <span>+</span></button>
      <div id="mobile-destinations" class="mobile-subnav" data-mobile-panel>
        <a href="/destinations/">All destinations</a>
        {featuredDestinations.map((destination) => <a href={`/destinations/${destination.slug}/`}>{destination.name}</a>)}
      </div>
      <button type="button" data-mobile-toggle="mobile-guides" aria-expanded="false" aria-controls="mobile-guides">Travel Guides <span>+</span></button>
      <div id="mobile-guides" class="mobile-subnav" data-mobile-panel>
        <a href="/blog/">All Travel Guides</a><a href="/tags/cities/">Cities</a><a href="/itineraries/">Trip Planning</a><a href="/tags/travel-planning/">Travel Planning</a>
      </div>
      <a href="/tags/travel-planning/">Travel Tips</a>
      <a href="/about/">About</a>
      <a href="/search/">Search</a>
    </nav>
  </div>
</header>

<style>
  .site-header{position:sticky;top:0;z-index:50;background:rgba(255,255,255,.96);backdrop-filter:blur(12px);border-bottom:1px solid #e4e0d8}
  .header-inner{min-height:74px;display:flex;align-items:center;justify-content:space-between}
  .site-logo{font-size:1.65rem;font-weight:950;letter-spacing:-.055em;color:#173d36;line-height:1}.site-logo span{color:#148eae}.site-logo b{color:#ef7c35}
  .desktop-nav{display:flex;align-items:center;gap:26px;font-size:.8rem;font-weight:800;color:#263b3d}.desktop-nav>a:hover,.nav-dropdown>button:hover{color:#148eae}
  .nav-dropdown{position:relative}.nav-dropdown>button{border:0;background:none;font:inherit;color:inherit;cursor:pointer;padding:10px 0}.nav-dropdown>button span{font-size:.7rem;margin-left:3px}
  .dropdown-panel{position:absolute;display:none;top:calc(100% + 10px);left:50%;transform:translateX(-50%);min-width:260px;padding:16px;background:#fff;border:1px solid #e3ded5;border-radius:14px;box-shadow:0 18px 40px rgba(20,50,50,.14);grid-template-columns:1fr;gap:4px}.dropdown-panel.is-open{display:grid}.dropdown-panel a{padding:9px 10px;border-radius:8px}.dropdown-panel a:hover{background:#f3f8f7;color:#148eae}.dropdown-kicker{margin:0 10px 5px;color:#148eae;font-size:.63rem;font-weight:900;letter-spacing:.16em;text-transform:uppercase}.dropdown-feature{font-weight:900}.guides-panel{min-width:220px}
  .search-button{display:inline-flex;align-items:center;gap:6px;background:#148eae;color:#fff!important;border-radius:999px;padding:10px 15px;box-shadow:0 4px 12px rgba(20,142,174,.15)}.search-button:hover{background:#117e99;transform:translateY(-1px)}
  .mobile-menu{display:none;border:1px solid #cbdfe1;background:#fff;border-radius:12px;padding:10px 15px;font:inherit;font-size:.85rem;font-weight:800;color:#263b3d}
  .mobile-nav{display:none;border-top:1px solid #e4e0d8;background:#fff}.mobile-nav nav{display:grid;gap:2px;padding-top:10px;padding-bottom:14px}.mobile-nav a,.mobile-nav button{padding:11px 8px;border:0;background:none;text-align:left;font:inherit;font-size:.9rem;font-weight:800;color:#263b3d;border-radius:8px}.mobile-nav a:hover,.mobile-nav button:hover{background:#f4f8f7;color:#148eae}.mobile-nav button{display:flex;justify-content:space-between;width:100%;cursor:pointer}.mobile-subnav{display:none;padding-left:14px;border-left:2px solid #d9ecee}.mobile-subnav.is-open{display:grid}.mobile-subnav a{font-size:.82rem;font-weight:700}
  @media(max-width:900px){.desktop-nav{display:none}.mobile-menu{display:block}.mobile-nav.is-open{display:block}}
  @media(max-width:520px){.header-inner{min-height:66px}.site-logo{font-size:1.45rem}.mobile-menu{padding:9px 14px}}
</style>

<script is:inline>
  (() => {
    const button = document.getElementById('nav-toggle');
    const panel = document.getElementById('mobile-nav');
    if (!button || !panel) return;
    const setMobile = (open) => { button.setAttribute('aria-expanded', String(open)); panel.classList.toggle('is-open', open); panel.setAttribute('aria-hidden', String(!open)); };
    button.addEventListener('click', () => setMobile(button.getAttribute('aria-expanded') !== 'true'));
    panel.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setMobile(false)));
    panel.querySelectorAll('[data-mobile-toggle]').forEach((toggle) => toggle.addEventListener('click', () => {
      const target = document.getElementById(toggle.getAttribute('aria-controls'));
      if (!target) return;
      const open = toggle.getAttribute('aria-expanded') !== 'true';
      toggle.setAttribute('aria-expanded', String(open)); target.classList.toggle('is-open', open);
      const icon = toggle.querySelector('span'); if (icon) icon.textContent = open ? '−' : '+';
    }));
    document.querySelectorAll('[data-menu-button]').forEach((menuButton) => {
      const target = document.getElementById(menuButton.getAttribute('aria-controls'));
      if (!target) return;
      menuButton.addEventListener('click', (event) => { event.stopPropagation(); const open = menuButton.getAttribute('aria-expanded') !== 'true'; document.querySelectorAll('[data-menu-button]').forEach((other) => { other.setAttribute('aria-expanded','false'); document.getElementById(other.getAttribute('aria-controls'))?.classList.remove('is-open'); }); menuButton.setAttribute('aria-expanded',String(open)); target.classList.toggle('is-open',open); });
    });
    document.addEventListener('click', () => document.querySelectorAll('[data-menu-button]').forEach((item) => { item.setAttribute('aria-expanded','false'); document.getElementById(item.getAttribute('aria-controls'))?.classList.remove('is-open'); }));
  })();
</script>
