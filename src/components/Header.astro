---
<header class="site-header">
  <div class="header-inner">
    <a href="/" class="logo" aria-label="RoamDawn home"><span>Roam</span><b>Dawn</b></a>

    <nav class="desktop-nav" aria-label="Primary navigation">
      <a href="/blog/">Stories</a>
      <a href="/destinations/">Destinations</a>
      <a href="/itineraries/">Travel Guides</a>
      <a href="/tags/travel-planning/">Travel Tips</a>
      <a href="/about/">About</a>
      <a class="search-link" href="/search/">Search</a>
    </nav>

    <button class="menu-button" type="button" aria-expanded="false" aria-controls="mobile-nav">Menu</button>
  </div>

  <div id="mobile-nav" class="mobile-nav" hidden>
    <nav aria-label="Mobile navigation">
      <a href="/blog/">Stories</a>
      <a href="/destinations/">Destinations</a>
      <a href="/itineraries/">Travel Guides</a>
      <a href="/tags/travel-planning/">Travel Tips</a>
      <a href="/about/">About</a>
      <a href="/search/">Search</a>
    </nav>
  </div>
</header>

<script>
  const menuButton = document.querySelector('.menu-button');
  const mobileNav = document.querySelector('#mobile-nav');

  if (menuButton && mobileNav) {
    menuButton.addEventListener('click', () => {
      const open = menuButton.getAttribute('aria-expanded') === 'true';
      menuButton.setAttribute('aria-expanded', String(!open));
      mobileNav.hidden = open;
    });

    mobileNav.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        menuButton.setAttribute('aria-expanded', 'false');
        mobileNav.hidden = true;
      });
    });
  }
</script>

<style>
  /* Clean header: there is intentionally NO top strip, promo bar, kicker, or extra row. */
  .site-header {
    position: relative;
    z-index: 10;
    display: block;
    width: 100%;
    height: auto;
    margin: 0 !important;
    padding: 0 !important;
    background: #fff !important;
    border: 0 !important;
    box-shadow: none !important;
  }

  .site-header::before,
  .site-header::after,
  .site-header > .top-bar,
  .site-header > .header-strip,
  .site-header > .kicker,
  .site-header > .announcement,
  .site-header > .promo-bar {
    display: none !important;
    content: none !important;
    height: 0 !important;
    margin: 0 !important;
    padding: 0 !important;
    border: 0 !important;
  }

  .header-inner {
    width: min(1120px, calc(100% - 52px));
    min-height: 76px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .logo {
    color: #202b30;
    text-decoration: none;
    font-size: 1.65rem;
    font-weight: 800;
    letter-spacing: -.06em;
  }

  .logo span { color: #202b30; }
  .logo b { color: #287c8b; font-weight: 800; }

  .desktop-nav { display: flex; align-items: center; gap: 27px; }
  .desktop-nav a { color: #36434a; font-size: .82rem; font-weight: 600; text-decoration: none; }
  .desktop-nav a:hover { color: #287c8b; }
  .desktop-nav .search-link { padding-left: 8px; color: #287c8b; }

  .menu-button {
    display: none;
    border: 0;
    background: transparent;
    color: #26343a;
    padding: 8px 0;
    font-size: .8rem;
    font-weight: 700;
  }

  .mobile-nav { background: #fff; border-top: 1px solid #eee; }
  .mobile-nav nav { width: calc(100% - 28px); margin: 0 auto; display: grid; }
  .mobile-nav a { padding: 14px 0; border-bottom: 1px solid #eef0f1; color: #26343a; text-decoration: none; font-size: .9rem; font-weight: 600; }
  .mobile-nav a:last-child { border-bottom: 0; }

  @media (max-width: 760px) {
    .header-inner { min-height: 64px; width: calc(100% - 28px); }
    .desktop-nav { display: none; }
    .menu-button { display: block; }
  }
</style>
