---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DestinationCard from '../../components/DestinationCard.astro';
import { destinations } from '../../data/destinations';
---
<BaseLayout
  title="Japan Travel Destination Guide | RoamDawn"
  description="Explore the RoamDawn Japan destination hub with practical seasonal planning, city guides and trip ideas."
  breadcrumbs={[{ label: 'Destinations', href: '/destinations/' }]}
>
  <section class="container py-14 md:py-16">
    <p class="font-bold uppercase tracking-wider text-[#168ac0]">Destination hub</p>
    <h1 class="mt-2 text-5xl font-black tracking-tight text-[#17324d] sm:text-6xl">Explore Japan</h1>
    <p class="mt-5 max-w-3xl text-lg leading-8 text-slate-600">Start with Japan, then move naturally into seasonal planning, city guides and practical trip advice. More destination hubs will be added only when their supporting content is ready.</p>
    <div class="mt-8 grid gap-4 rounded-2xl border border-sky-100 bg-white p-5 sm:grid-cols-3">
      <div><b class="text-slate-900">Seasonal planning</b><p class="mt-1 text-sm text-slate-600">Choose dates around weather, scenery and travel style.</p></div>
      <div><b class="text-slate-900">City guides</b><p class="mt-1 text-sm text-slate-600">Compare Tokyo, Kyoto, Osaka and other Japanese cities.</p></div>
      <div><b class="text-slate-900">Practical trips</b><p class="mt-1 text-sm text-slate-600">Build realistic routes without overloading your itinerary.</p></div>
    </div>
    <div class="mt-10 grid gap-6 md:max-w-2xl">
      {destinations.map((d) => <DestinationCard name={d.name} slug={d.slug} description={d.intro} image={d.image} />)}
    </div>
  </section>
</BaseLayout>
