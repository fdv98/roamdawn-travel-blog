---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getCollection } from 'astro:content';
import { destinations } from '../../data/destinations';
export function getStaticPaths(){return destinations.map(destination=>({params:{slug:destination.slug},props:{destination}}))}
const {destination}=Astro.props; const posts=(await getCollection('blog',{filter:({data})=>!data.draft && data.category===destination.name})).sort((a,b)=>b.data.publishDate.valueOf()-a.data.publishDate.valueOf());
---
<BaseLayout title={`${destination.primary} | ${destination.name} Travel Guide | RoamDawn`} description={`${destination.intro} Explore practical travel guides, itineraries and planning advice.`} image={destination.image}><section class="container py-10"><Breadcrumbs items={[{label:'Destinations',href:'/destinations/'},{label:destination.name,href:`/destinations/${destination.slug}/`}]}/><div class="overflow-hidden rounded-[2rem] bg-white shadow-sm"><img src={destination.image} alt={`${destination.name} travel guide`} width="1600" height="900" class="aspect-[16/6] w-full object-cover" loading="eager"/><div class="p-7 md:p-10"><p class="font-bold uppercase tracking-wider text-[#168ac0]">Destination hub</p><h1 class="mt-2 max-w-4xl text-4xl font-black sm:text-6xl">{destination.primary}</h1><p class="mt-5 max-w-3xl text-lg leading-8 text-slate-700">{destination.intro}</p><div class="mt-7 flex flex-wrap gap-2">{destination.places.map((p:string)=><span class="rounded-full bg-stone-100 px-4 py-2 text-sm font-semibold">{p}</span>)}</div></div></div><section class="py-14"><div class="flex items-end justify-between"><div><p class="font-bold text-[#168ac0]">Build your trip</p><h2 class="text-3xl font-black">{destination.name} travel guides</h2></div><a href="/blog/" class="font-bold text-[#168ac0]">All guides →</a></div><div class="mt-7 grid gap-5 md:grid-cols-2 lg:grid-cols-3">{posts.map(post=><ArticleCard post={post}/>)}</div></section><section class="grid gap-8 border-t border-stone-200 py-12 md:grid-cols-3"><div><h2 class="text-xl font-black">Best starting point</h2><p class="mt-2 text-sm leading-6 text-slate-600">Begin with the pillar guide, then use city and itinerary pages to shape the route.</p></div><div><h2 class="text-xl font-black">Timing matters</h2><p class="mt-2 text-sm leading-6 text-slate-600">Weather, crowds, daylight and opening schedules can change the best choice for your dates.</p></div><div><h2 class="text-xl font-black">Verify before booking</h2><p class="mt-2 text-sm leading-6 text-slate-600">Check official government, transport, park and attraction sources for current rules.</p></div></section></section></BaseLayout>