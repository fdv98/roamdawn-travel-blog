---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { destinations } from '../../data/destinations';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const destination = destinations.find((d) => d.name === post.data.category);
const related = (await getCollection('blog', ({ data }) => !data.draft && data.category === post.data.category))
  .filter((p) => p.id !== post.id)
  .slice(0, 3);
const breadcrumbItems = [
  { label: 'Travel Guides', href: '/blog/' },
  ...(destination ? [{ label: destination.name, href: `/destinations/${destination.slug}/` }] : []),
];
const articleClass = `prose article-${post.id}`;

const cityImages: Record<string, { src: string; alt: string }> = {
  'best-cities-to-visit-in-japan': {
    src: '/images/destinations/japan/best-cities-to-visit-in-japan-tokyo-japan-travel-skyline.webp',
    alt: 'Tokyo city skyline in Japan',
  },
  'best-time-to-visit-japan': {
    src: '/images/destinations/japan/best-time-to-visit-japan-featured.svg',
    alt: 'Mount Fuji and spring flowers in Japan',
  },
};
const articleImage = cityImages[post.id] ?? {
  src: post.data.featuredImage,
  alt: `Illustration for ${post.data.title}`,
};
---
<BaseLayout
  title={`${post.data.title} | RoamDawn`}
  description={post.data.description}
  image={articleImage.src}
  type="article"
  published={post.data.publishDate.toISOString()}
  updated={(post.data.updatedDate || post.data.publishDate).toISOString()}
  breadcrumbs={breadcrumbItems}
>
  <article class="container article-page py-10 md:py-12">
    <Breadcrumbs items={breadcrumbItems} />
    <header class="article-header max-w-4xl">
      <p class="article-category font-bold uppercase tracking-wider text-[#168ac0]">{post.data.category}</p>
      <h1 class="mt-3">{post.data.title}</h1>
      <p class="article-description mt-5">{post.data.description}</p>
      <div class="article-meta mt-5 flex flex-wrap gap-4">{post.data.author} · {post.data.readingTime} min read · Updated {post.data.updatedDate?.toLocaleDateString('en-US') || post.data.publishDate.toLocaleDateString('en-US')}</div>
    </header>

    <figure class="mt-8 overflow-hidden rounded-3xl border border-stone-200 bg-white shadow-sm">
      <img
        src={articleImage.src}
        alt={articleImage.alt}
        width="1600"
        height="900"
        loading="eager"
        decoding="async"
        class="block aspect-[16/9] w-full object-cover"
      />
    </figure>

    <div class="mt-10 lg:grid lg:grid-cols-[minmax(0,1fr)_260px] lg:gap-12">
      <div class={articleClass}><Content /></div>
      <aside class="mt-10 lg:mt-0"><div class="sticky top-24 rounded-2xl border border-sky-100 bg-white p-5 shadow-sm"><b>About this guide</b><p class="mt-2 text-sm leading-6 text-slate-600">RoamDawn guides focus on practical planning. Verify time-sensitive details with official sources before travel.</p><a href="/disclaimer/" class="mt-4 inline-block text-sm font-bold text-[#168ac0]">Travel disclaimer →</a></div></aside>
    </div>
    {related.length > 0 && <section class="mt-14" aria-labelledby="related-guides"><h2 id="related-guides" class="text-3xl font-black text-[#17324d]">More {post.data.category} guides</h2><div class="mt-6 grid gap-5 md:grid-cols-2">{related.map((item) => <ArticleCard post={item} />)}</div></section>}
  </article>
</BaseLayout>

<style is:global>
  .article-page { color: #26343d; }

  .article-header { max-width: 820px; }

  /* Deliberately restrained editorial scale: readable on mobile without oversized wrapping. */
  .article-header h1 {
    margin: .75rem 0 0;
    max-width: 780px;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(2.15rem, 4.2vw, 3.25rem) !important;
    font-weight: 700 !important;
    letter-spacing: -0.025em;
    line-height: 1.12 !important;
    color: #172b36 !important;
  }

  .article-category {
    font-family: Inter, ui-sans-serif, system-ui, sans-serif;
    font-size: .72rem;
    letter-spacing: .14em;
  }

  .article-description {
    max-width: 720px;
    font-family: Inter, ui-sans-serif, system-ui, sans-serif;
    font-size: 1.08rem !important;
    line-height: 1.65 !important;
    color: #66747c !important;
  }

  .article-meta {
    font-family: Inter, ui-sans-serif, system-ui, sans-serif;
    font-size: .8rem !important;
    line-height: 1.5;
    color: #7b878d !important;
  }

  .article-page .prose {
    max-width: 760px;
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    font-size: 1.05rem;
    line-height: 1.8;
    color: #35444d;
  }

  .article-page .prose p { margin: 0 0 1.3rem; }

  .article-page .prose h2 {
    margin: 2.7rem 0 1rem;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(1.55rem, 2.5vw, 2rem);
    font-weight: 700;
    line-height: 1.28;
    letter-spacing: -.02em;
    color: #172b36;
  }

  .article-page .prose h3 {
    margin: 2rem 0 .7rem;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 1.3rem;
    font-weight: 700;
    line-height: 1.3;
    color: #20343e;
  }

  .article-page .prose ul,
  .article-page .prose ol { margin: 1.1rem 0 1.6rem; padding-left: 1.4rem; }
  .article-page .prose li { margin: .5rem 0; padding-left: .2rem; }
  .article-page .prose strong { color: #233740; font-weight: 700; }
  .article-page .prose a { color: #167fa9; text-decoration-color: rgba(22,127,169,.35); }

  .article-page .prose blockquote {
    margin: 2rem 0;
    padding: 1rem 1.25rem;
    border-left: 3px solid #ef7440;
    background: #f7fafb;
    border-radius: 0 .7rem .7rem 0;
  }

  .article-page figure img { background: #f4f7f8; }

  @media (max-width: 640px) {
    .article-page { padding-top: 1.25rem !important; }

    .article-header h1 {
      font-size: 2.35rem !important;
      line-height: 1.12 !important;
      letter-spacing: -0.02em;
    }

    .article-description {
      font-size: 1rem !important;
      line-height: 1.65 !important;
    }

    .article-page .prose {
      font-size: 1rem;
      line-height: 1.78;
    }

    .article-page .prose h2 {
      margin-top: 2.2rem;
      font-size: 1.55rem;
    }

    .article-page .prose h3 {
      margin-top: 1.6rem;
      font-size: 1.2rem;
    }
  }
</style>
