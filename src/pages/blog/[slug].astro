---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { destinations } from '../../data/destinations';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const destination = destinations.find((d) => d.name === post.data.category);
const related = (await getCollection('blog', ({ data }) => !data.draft && data.category === post.data.category))
  .filter((p) => p.id !== post.id).slice(0, 3);
const breadcrumbItems = [
  { label: 'Travel Guides', href: '/blog/' },
  ...(destination ? [{ label: destination.name, href: `/destinations/${destination.slug}/` }] : []),
];
const articleClass = `prose article-${post.id}`;
const cityImages: Record<string, { src: string; alt: string }> = {
  'best-cities-to-visit-in-japan': { src: '/images/destinations/japan/best-cities-to-visit-in-japan-tokyo-japan-travel-skyline.webp', alt: 'Tokyo city skyline in Japan' },
  'best-time-to-visit-japan': { src: '/images/destinations/japan/best-time-to-visit-japan-featured.svg', alt: 'Mount Fuji and spring flowers in Japan' },
};
const articleImage = cityImages[post.id] ?? { src: post.data.featuredImage, alt: `Illustration for ${post.data.title}` };
const getYourGuideUrl = 'https://www.getyourguide.com/?partner_id=I2IX6UW&utm_medium=online_publisher';
const northernLightsTrainImage = '/images/destinations/northern-lights/northern-lights-japan-train.jpg';
---
<BaseLayout title={`${post.data.title} | RoamDawn`} description={post.data.description} image={articleImage.src} type="article" published={post.data.publishDate.toISOString()} updated={(post.data.updatedDate || post.data.publishDate).toISOString()} breadcrumbs={breadcrumbItems}>
  <article class="container article-page py-10 md:py-12">
    <Breadcrumbs items={breadcrumbItems} />
    <header class="article-header">
      <p class="article-category">{post.data.category}</p>
      <h1>{post.data.title}</h1>
      <p class="article-description">{post.data.description}</p>
      <div class="article-meta">{post.data.author} · {post.data.readingTime} min read · Updated {post.data.updatedDate?.toLocaleDateString('en-US') || post.data.publishDate.toLocaleDateString('en-US')}</div>
    </header>
    <figure class="article-hero-image"><img src={articleImage.src} alt={articleImage.alt} width="1600" height="900" loading="eager" decoding="async" /></figure>
    {post.id === 'best-time-to-visit-northern-lights' && <>
      <figure class="article-inline-image"><img src={northernLightsTrainImage} alt="Snow-covered train arriving at a railway station in Japan" width="1536" height="1024" loading="lazy" decoding="async" /></figure>
      <div class="affiliate-box">
        <p><strong>Plan your Northern Lights trip</strong></p>
        <p>Compare tours, activities and local experiences with GetYourGuide.</p>
        <a href={getYourGuideUrl} target="_blank" rel="sponsored nofollow noopener">Explore Northern Lights tours →</a>
        <small>This is an affiliate link. RoamDawn may earn a commission at no extra cost to you.</small>
      </div>
    </>}
    <div class="article-layout">
      <div class={articleClass}><Content /></div>
      <aside class="article-aside"><div class="aside-card"><b>About this guide</b><p>RoamDawn guides focus on practical planning. Verify time-sensitive details with official sources before travel.</p><a href="/disclaimer/">Travel disclaimer →</a></div></aside>
    </div>
    {related.length > 0 && <section class="related" aria-labelledby="related-guides"><h2 id="related-guides">More {post.data.category} guides</h2><div class="related-grid">{related.map((item) => <ArticleCard post={item} />)}</div></section>}
  </article>
</BaseLayout>

<style is:global>
  .article-page { color: #26343d; background: #fff; }
  .article-header { max-width: 760px; }
  .article-category { margin: 0; color: #287c8b; font: 600 .68rem/1.4 Inter, ui-sans-serif, system-ui, sans-serif; letter-spacing: .08em; text-transform: uppercase; }
  .article-header h1 { margin: .55rem 0 .8rem; max-width: 720px; font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; font-size: clamp(1.7rem, 2.8vw, 2.35rem) !important; font-weight: 650 !important; letter-spacing: -.018em; line-height: 1.18 !important; color: #2b3940 !important; }
  .article-description { max-width: 680px; margin: 0; font: 400 .96rem/1.7 Inter, ui-sans-serif, system-ui, sans-serif; color: #6d797f; }
  .article-meta { margin-top: 11px; font: 400 .74rem/1.5 Inter, ui-sans-serif, system-ui, sans-serif; color: #858f94; }
  .article-hero-image { width: min(100%, 780px); aspect-ratio: 16 / 9; margin: 26px 0 0; overflow: hidden; border: 0; border-radius: 0; background: #f4f6f7; box-shadow: none; }
  .article-hero-image img { display: block; width: 100%; height: 100%; object-fit: cover; border: 0; border-radius: 0; box-shadow: none; }
  .article-inline-image { width: min(100%, 760px); margin: 30px 0 0; }
  .article-inline-image img { display: block; width: 100%; height: auto; max-width: 760px; border-radius: 0; }
  .affiliate-box { width: min(100%, 760px); margin: 20px 0 0; padding: 18px 20px; border: 1px solid #dce8eb; border-radius: 12px; background: #f7fbfc; }
  .affiliate-box p { margin: 0 0 5px; color: #34454d; }
  .affiliate-box a { display: inline-block; margin-top: 8px; color: #167fa9; font-weight: 700; text-decoration: none; }
  .affiliate-box small { display: block; margin-top: 8px; color: #748188; font-size: .72rem; line-height: 1.5; }
  .article-layout { display: grid; grid-template-columns: minmax(0, 760px) 240px; gap: 48px; align-items: start; margin-top: 34px; }
  .article-page .prose { max-width: 760px; font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; font-size: .98rem; line-height: 1.82; color: #424f56; }
  .article-page .prose p { margin: 0 0 1.15rem; }
  .article-page .prose h2 { margin: 2.35rem 0 .75rem; font-family: Inter, ui-sans-serif, system-ui, sans-serif; font-size: clamp(1.28rem, 2vw, 1.58rem); font-weight: 650; line-height: 1.34; letter-spacing: -.012em; color: #2d3b42; }
  .article-page .prose h3 { margin: 1.7rem 0 .55rem; font-family: Inter, ui-sans-serif, system-ui, sans-serif; font-size: 1.1rem; font-weight: 650; line-height: 1.42; color: #34434a; }
  .article-page .prose ul, .article-page .prose ol { margin: 1rem 0 1.4rem; padding-left: 1.3rem; }
  .article-page .prose li { margin: .4rem 0; }
  .article-page .prose strong { color: #38474e; font-weight: 650; }
  .article-page .prose a { color: #167fa9; text-decoration-color: rgba(22,127,169,.25); }
  .article-page .prose blockquote { margin: 1.8rem 0; padding: .9rem 1.05rem; border-left: 3px solid #ef7440; background: #f7fafb; }
  .article-aside { position: sticky; top: 24px; }
  .aside-card { padding: 18px; border: 1px solid #e3e8ea; background: #fff; }
  .aside-card b { color: #2f3d44; font-size: .84rem; }
  .aside-card p { margin: 8px 0 0; color: #68747b; font-size: .75rem; line-height: 1.65; }
  .aside-card a { display: inline-block; margin-top: 12px; color: #287c8b; font-size: .75rem; font-weight: 650; }
  .related { margin-top: 55px; padding-top: 28px; border-top: 1px solid #e5e8e9; }
  .related h2 { margin: 0; font-family: Inter, ui-sans-serif, system-ui, sans-serif; font-size: 1.45rem; font-weight: 650; color: #2d3b42; }
  .related-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; margin-top: 20px; }
  @media (max-width: 900px) { .article-layout { grid-template-columns: 1fr; gap: 28px; } .article-aside { position: static; } }
  @media (max-width: 640px) {
    .article-page { padding-top: 1.25rem !important; }
    .article-header h1 { font-size: 1.72rem !important; line-height: 1.2 !important; letter-spacing: -.012em; }
    .article-description { font-size: .94rem; line-height: 1.68; }
    .article-meta { font-size: .72rem; }
    .article-hero-image { width: 100%; margin-top: 20px; }
    .article-inline-image { margin-top: 22px; }
    .affiliate-box { margin-top: 16px; padding: 15px; }
    .article-page .prose { font-size: .95rem; line-height: 1.78; }
    .article-page .prose h2 { margin-top: 1.9rem; font-size: 1.3rem; }
    .article-page .prose h3 { margin-top: 1.45rem; font-size: 1.08rem; }
    .related-grid { grid-template-columns: 1fr; }
  }
</style>
