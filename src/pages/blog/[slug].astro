---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { destinations } from '../../data/destinations';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const destination = destinations.find((d) => d.name === post.data.category);
const related = (await getCollection('blog', ({ data }) => !data.draft && data.category === post.data.category))
  .filter((p) => p.id !== post.id)
  .slice(0, 3);
const breadcrumbItems = [
  { label: 'Travel Guides', href: '/blog/' },
  ...(destination ? [{ label: destination.name, href: `/destinations/${destination.slug}/` }] : []),
];
const articleClass = `prose article-${post.id}`;

const cityImages: Record<string, { src: string; alt: string }> = {
  'best-cities-to-visit-in-japan': {
    src: '/images/destinations/japan/best-cities-to-visit-in-japan-tokyo-japan-travel-skyline.webp',
    alt: 'Tokyo city skyline in Japan',
  },
  'best-time-to-visit-japan': {
    src: '/images/destinations/japan/best-time-to-visit-japan-featured.svg',
    alt: 'Mount Fuji and spring flowers in Japan',
  },
};
const articleImage = cityImages[post.id] ?? {
  src: post.data.featuredImage,
  alt: `Illustration for ${post.data.title}`,
};
---
<BaseLayout
  title={`${post.data.title} | RoamDawn`}
  description={post.data.description}
  image={articleImage.src}
  type="article"
  published={post.data.publishDate.toISOString()}
  updated={(post.data.updatedDate || post.data.publishDate).toISOString()}
  breadcrumbs={breadcrumbItems}
>
  <article class="container article-page py-10 md:py-12">
    <Breadcrumbs items={breadcrumbItems} />
    <header class="article-header">
      <p class="article-category">{post.data.category}</p>
      <h1>{post.data.title}</h1>
      <p class="article-description">{post.data.description}</p>
      <div class="article-meta">{post.data.author} · {post.data.readingTime} min read · Updated {post.data.updatedDate?.toLocaleDateString('en-US') || post.data.publishDate.toLocaleDateString('en-US')}</div>
    </header>

    <figure class="article-hero-image">
      <img src={articleImage.src} alt={articleImage.alt} width="1600" height="900" loading="eager" decoding="async" />
    </figure>

    <div class="article-layout">
      <div class={articleClass}><Content /></div>
      <aside class="article-aside"><div class="aside-card"><b>About this guide</b><p>RoamDawn guides focus on practical planning. Verify time-sensitive details with official sources before travel.</p><a href="/disclaimer/">Travel disclaimer →</a></div></aside>
    </div>

    {related.length > 0 && <section class="related" aria-labelledby="related-guides"><h2 id="related-guides">More {post.data.category} guides</h2><div class="related-grid">{related.map((item) => <ArticleCard post={item} />)}</div></section>}
  </article>
</BaseLayout>

<style is:global>
  .article-page { color: #26343d; background: #fff; }
  .article-header { max-width: 760px; }
  .article-category { margin: 0; color: #287c8b; font: 700 .72rem/1.4 Inter, ui-sans-serif, system-ui, sans-serif; letter-spacing: .12em; text-transform: uppercase; }
  .article-header h1 { margin: .65rem 0 1rem; max-width: 760px; font-family: Georgia, 'Times New Roman', serif; font-size: clamp(2rem, 3.6vw, 3rem) !important; font-weight: 700 !important; letter-spacing: -.025em; line-height: 1.12 !important; color: #172b36 !important; }
  .article-description { max-width: 720px; margin: 0; font: 400 1rem/1.7 Inter, ui-sans-serif, system-ui, sans-serif; color: #66747c; }
  .article-meta { margin-top: 14px; font: 400 .78rem/1.5 Inter, ui-sans-serif, system-ui, sans-serif; color: #7b878d; }

  .article-hero-image { width: min(100%, 780px); aspect-ratio: 16 / 9; margin: 30px 0 0; overflow: hidden; border: 0; border-radius: 0; background: #f4f6f7; box-shadow: none; }
  .article-hero-image img { display: block; width: 100%; height: 100%; object-fit: cover; border: 0; border-radius: 0; box-shadow: none; }

  .article-layout { display: grid; grid-template-columns: minmax(0, 760px) 240px; gap: 48px; align-items: start; margin-top: 38px; }
  .article-page .prose { max-width: 760px; font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; font-size: 1rem; line-height: 1.78; color: #35444d; }
  .article-page .prose p { margin: 0 0 1.25rem; }
  .article-page .prose h2 { margin: 2.6rem 0 .9rem; font-family: Georgia, 'Times New Roman', serif; font-size: clamp(1.45rem, 2.4vw, 1.9rem); font-weight: 700; line-height: 1.3; letter-spacing: -.015em; color: #1d313b; }
  .article-page .prose h3 { margin: 1.9rem 0 .65rem; font-family: Georgia, 'Times New Roman', serif; font-size: 1.25rem; font-weight: 700; line-height: 1.35; color: #253b45; }
  .article-page .prose ul, .article-page .prose ol { margin: 1rem 0 1.5rem; padding-left: 1.35rem; }
  .article-page .prose li { margin: .45rem 0; }
  .article-page .prose strong { color: #243840; font-weight: 700; }
  .article-page .prose a { color: #167fa9; text-decoration-color: rgba(22,127,169,.35); }
  .article-page .prose blockquote { margin: 2rem 0; padding: 1rem 1.1rem; border-left: 3px solid #ef7440; background: #f7fafb; }

  .article-aside { position: sticky; top: 24px; }
  .aside-card { padding: 18px; border: 1px solid #e3e8ea; background: #fff; }
  .aside-card b { color: #22353e; font-size: .9rem; }
  .aside-card p { margin: 8px 0 0; color: #68747b; font-size: .78rem; line-height: 1.65; }
  .aside-card a { display: inline-block; margin-top: 12px; color: #287c8b; font-size: .78rem; font-weight: 700; }

  .related { margin-top: 58px; padding-top: 30px; border-top: 1px solid #e5e8e9; }
  .related h2 { margin: 0; font-family: Georgia, 'Times New Roman', serif; font-size: 1.8rem; color: #1d313b; }
  .related-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; margin-top: 20px; }

  @media (max-width: 900px) {
    .article-layout { grid-template-columns: 1fr; gap: 28px; }
    .article-aside { position: static; }
  }

  @media (max-width: 640px) {
    .article-page { padding-top: 1.25rem !important; }
    .article-header h1 { font-size: 2rem !important; line-height: 1.15 !important; }
    .article-description { font-size: .96rem; line-height: 1.7; }
    .article-meta { font-size: .75rem; }
    .article-hero-image { width: 100%; margin-top: 22px; }
    .article-page .prose { font-size: .98rem; line-height: 1.76; }
    .article-page .prose h2 { margin-top: 2.1rem; font-size: 1.45rem; }
    .article-page .prose h3 { margin-top: 1.6rem; font-size: 1.18rem; }
    .related-grid { grid-template-columns: 1fr; }
  }
</style>
