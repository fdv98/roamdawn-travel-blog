---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { destinations } from '../../data/destinations';
export async function getStaticPaths(){const posts=await getCollection('blog',{filter:({data})=>!data.draft});return posts.map(post=>({params:{slug:post.id},props:{post}}))}
const {post}=Astro.props; const {Content}=await post.render(); const destination=destinations.find(d=>d.name===post.data.category); const related=(await getCollection('blog',{filter:({data})=>!data.draft&&data.category===post.data.category})).filter(p=>p.id!==post.id).slice(0,3);
---
<BaseLayout title={`${post.data.title} | RoamDawn`} description={post.data.description} image={post.data.featuredImage} type="article" published={post.data.publishDate.toISOString()} updated={(post.data.updatedDate||post.data.publishDate).toISOString()}><article class="container py-10"><Breadcrumbs items={[{label:'Travel Guides',href:'/blog/'},{label:post.data.category,href:`/destinations/${destination?.slug}/`},{label:post.data.title,href:`/blog/${post.id}/`}]} /><header class="max-w-4xl"><p class="font-bold uppercase tracking-wider text-[#168ac0]">{post.data.category}</p><h1 class="mt-3 text-4xl font-black leading-tight sm:text-6xl">{post.data.title}</h1><p class="mt-5 text-xl leading-8 text-slate-600">{post.data.description}</p><div class="mt-5 flex flex-wrap gap-4 text-sm text-slate-500">{post.data.author} · {post.data.readingTime} min read · Updated {post.data.updatedDate?.toLocaleDateString('en-US')||post.data.publishDate.toLocaleDateString('en-US')}</div></header><img src={post.data.featuredImage} alt={post.data.title} width="1600" height="900" class="mt-8 w-full rounded-3xl" loading="eager"/><div class="mt-10 lg:grid lg:grid-cols-[minmax(0,1fr)_260px] lg:gap-12"><div class="prose"><Content/></div><aside class="mt-10 lg:mt-0"><div class="sticky top-24 rounded-2xl border bg-white p-5"><b>About this guide</b><p class="mt-2 text-sm text-slate-600">RoamDawn guides focus on practical planning. Verify time-sensitive details with official sources before travel.</p><a href="/disclaimer/" class="mt-4 inline-block text-sm font-bold text-[#168ac0]">Travel disclaimer →</a></div></aside></div><section class="mt-14"><h2 class="text-3xl font-black">More {post.data.category} guides</h2><div class="mt-6 grid gap-5 md:grid-cols-3">{related.map(item=><ArticleCard post={item}/>)}</div></section></article></BaseLayout>