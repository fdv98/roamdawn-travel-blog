---
import BaseLayout from '../../layouts/BaseLayout.astro'; import ArticleCard from '../../components/ArticleCard.astro'; import {getCollection} from 'astro:content';
const posts=(await getCollection('blog', ({ data }) => !data.draft)).sort((a,b)=>b.data.publishDate.valueOf()-a.data.publishDate.valueOf());
---
<BaseLayout title="Travel Guides | RoamDawn" description="Browse RoamDawn's practical destination guides, city guides and itineraries for planning trips around the world."><section class="container py-14"><p class="font-bold uppercase tracking-wider text-[#168ac0]">Travel library</p><h1 class="mt-2 text-5xl font-black">Travel guides that answer real planning questions</h1><p class="mt-5 max-w-3xl text-lg text-slate-600">Start with a broad destination question, then move into specific cities, routes and practical details.</p><div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3">{posts.map(post=><ArticleCard post={post}/>)}</div></section></BaseLayout>