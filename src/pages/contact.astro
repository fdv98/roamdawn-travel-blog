---
import BaseLayout from '../layouts/BaseLayout.astro';
const contactEndpoint = import.meta.env.CONTACT_ENDPOINT;
const contactEmail = import.meta.env.CONTACT_EMAIL || 'contact@roamdawn.info';
---
<BaseLayout title="Contact RoamDawn" description="Contact the RoamDawn Editorial Team with corrections, questions and feedback.">
  <section class="contact-page container max-w-3xl py-12 md:py-16">
    <p class="eyebrow">Get in touch</p>
    <h1>Contact RoamDawn</h1>
    <p class="intro">Have a correction, question or suggestion? Send us a message using the form below. We read every genuine message and use feedback to improve our travel guides.</p>

    <form id="contact-form" action={contactEndpoint || `mailto:${contactEmail}`} method={contactEndpoint ? 'post' : 'post'} class="contact-form">
      <div class="field-grid">
        <label>Name<input name="name" required autocomplete="name" /></label>
        <label>Email<input name="email" type="email" required autocomplete="email" /></label>
      </div>
      <label>Subject<input name="subject" required /></label>
      <label>Message<textarea name="message" rows="8" required></textarea></label>
      <button type="submit">Send message</button>
      <p id="contact-status" class="status" aria-live="polite"></p>
    </form>

    <p class="email-note">Prefer email? <a href={`mailto:${contactEmail}`}>{contactEmail}</a></p>
    <p class="delivery-note">Messages can be sent directly to our contact email. If a secure form endpoint is configured later, the form will use that endpoint automatically.</p>
  </section>
</BaseLayout>

<script is:inline define:vars={{ hasEndpoint: Boolean(contactEndpoint), email: contactEmail }}>
  const form = document.querySelector('#contact-form');
  const status = document.querySelector('#contact-status');

  form?.addEventListener('submit', (event) => {
    if (hasEndpoint) return;
    event.preventDefault();
    const data = new FormData(form);
    const subject = encodeURIComponent(String(data.get('subject') || 'RoamDawn contact message'));
    const body = encodeURIComponent(`Name: ${data.get('name') || ''}\nEmail: ${data.get('email') || ''}\n\n${data.get('message') || ''}`);
    window.location.href = `mailto:${email}?subject=${subject}&body=${body}`;
    if (status) {
      status.textContent = 'Your email app will open with the message prepared for RoamDawn.';
      status.classList.add('visible');
    }
  });
</script>

<style>
  .contact-page { color: #26343d; }
  .eyebrow { margin: 0; color: #287c8b; font-size: .72rem; font-weight: 700; letter-spacing: .13em; text-transform: uppercase; }
  h1 { margin: .65rem 0 1rem; font-family: Georgia, 'Times New Roman', serif; font-size: clamp(2.4rem, 6vw, 3.5rem); line-height: 1.1; letter-spacing: -.03em; color: #182b35; }
  .intro { max-width: 720px; margin: 0; color: #68747b; font-size: 1.05rem; line-height: 1.75; }
  .contact-form { display: grid; gap: 20px; margin-top: 32px; padding: 28px; background: #fff; border: 1px solid #e3e7e8; }
  label { display: grid; gap: 8px; color: #253740; font-size: .9rem; font-weight: 700; }
  input, textarea { width: 100%; border: 1px solid #d8dfe2; background: #fff; color: #26343d; padding: 13px 14px; font: inherit; border-radius: 4px; outline: none; }
  input:focus, textarea:focus { border-color: #287c8b; box-shadow: 0 0 0 3px rgba(40,124,139,.12); }
  textarea { min-height: 180px; resize: vertical; }
  button { width: fit-content; border: 0; border-radius: 999px; padding: 12px 20px; background: #287c8b; color: #fff; font-size: .9rem; font-weight: 700; cursor: pointer; }
  button:hover { background: #216d79; }
  .status { display: none; margin: -6px 0 0; color: #287c8b; font-size: .85rem; line-height: 1.6; }
  .status.visible { display: block; }
  .email-note { margin: 18px 0 0; color: #68747b; font-size: .9rem; }
  .email-note a { color: #287c8b; font-weight: 700; }
  .delivery-note { margin: 8px 0 0; color: #8a9499; font-size: .78rem; line-height: 1.6; }
  .field-grid { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 18px; }
  @media (max-width: 620px) { .contact-page { padding-top: 28px; padding-bottom: 55px; } .contact-form { padding: 20px; } .field-grid { grid-template-columns: 1fr; } h1 { font-size: 2.35rem; } }
</style>
