---
import BaseLayout from '../layouts/BaseLayout.astro';
const contactEndpoint = import.meta.env.CONTACT_ENDPOINT;
---
<BaseLayout title="Contact RoamDawn" description="Contact the RoamDawn Editorial Team with corrections, questions and feedback.">
  <section class="container max-w-3xl py-14 md:py-16">
    <p class="font-bold uppercase tracking-wider text-[#168ac0]">Get in touch</p>
    <h1 class="mt-2 text-5xl font-black text-[#17324d]">Contact RoamDawn</h1>
    <p class="mt-5 text-lg leading-8 text-slate-600">Use this page for corrections, editorial questions or general feedback.</p>

    {contactEndpoint ? (
      <form action={contactEndpoint} method="post" class="mt-8 grid gap-5 rounded-2xl border border-sky-100 bg-white p-6 shadow-sm sm:p-8">
        <label class="font-semibold text-[#17324d]">Name<input name="name" required autocomplete="name" class="mt-2 w-full rounded-xl border border-slate-200 p-3 outline-none focus:border-[#168ac0] focus:ring-4 focus:ring-sky-100" /></label>
        <label class="font-semibold text-[#17324d]">Email<input name="email" type="email" required autocomplete="email" class="mt-2 w-full rounded-xl border border-slate-200 p-3 outline-none focus:border-[#168ac0] focus:ring-4 focus:ring-sky-100" /></label>
        <label class="font-semibold text-[#17324d]">Subject<input name="subject" required class="mt-2 w-full rounded-xl border border-slate-200 p-3 outline-none focus:border-[#168ac0] focus:ring-4 focus:ring-sky-100" /></label>
        <label class="font-semibold text-[#17324d]">Message<textarea name="message" rows="7" required class="mt-2 w-full rounded-xl border border-slate-200 p-3 outline-none focus:border-[#168ac0] focus:ring-4 focus:ring-sky-100"></textarea></label>
        <button class="w-fit rounded-full bg-[#1596c2] px-6 py-3 font-bold text-white hover:bg-[#117fa5]">Send message</button>
      </form>
    ) : (
      <div class="mt-8 rounded-2xl border border-amber-200 bg-[#fff8e8] p-6 text-slate-700 sm:p-8">
        <h2 class="text-2xl font-black text-[#17324d]">Contact form not configured yet</h2>
        <p class="mt-3 leading-7">The page is ready for a secure form endpoint, but no endpoint is currently configured. Add <code class="rounded bg-white px-1.5 py-0.5 text-sm">CONTACT_ENDPOINT</code> in the hosting environment before enabling submissions.</p>
      </div>
    )}
  </section>
</BaseLayout>
