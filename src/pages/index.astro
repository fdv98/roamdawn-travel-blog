---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import DestinationCard from '../components/DestinationCard.astro';
import { getCollection } from 'astro:content';
import { destinations } from '../data/destinations';
const posts=(await getCollection('blog',{filter:({data})=>!data.draft})).sort((a,b)=>b.data.publishDate.valueOf()-a.data.publishDate.valueOf());
---
<BaseLayout title="RoamDawn — Travel Guides, Destinations & Adventure" description="Practical travel guides, destination ideas and itineraries to help you plan better journeys around the world.">
<section class="bg-[#dff3f7]"><div class="container grid gap-10 py-16 md:grid-cols-[1.1fr_.9fr] md:items-center md:py-24"><div><p class="font-bold uppercase tracking-[.18em] text-[#168ac0]">RoamDawn travel publication</p><h1 class="mt-4 max-w-4xl text-5xl font-black leading-[1.02] sm:text-7xl">Discover the World, One Journey at a Time</h1><p class="mt-6 max-w-2xl text-lg leading-8 text-slate-700">Practical travel guides, destination ideas, itineraries and useful planning advice, built for travelers who want clarity before they book.</p><div class="mt-8 flex flex-wrap gap-3"><a class="rounded-full bg-[#18232d] px-6 py-3 font-bold text-white" href="/destinations/">Explore Destinations</a><a class="rounded-full border border-stone-300 bg-white px-6 py-3 font-bold" href="/blog/">Read Travel Guides</a></div></div><div class="rounded-[2rem] bg-gradient-to-br from-[#168ac0] via-[#f3b545] to-[#2f8f67] p-2 shadow-xl"><div class="rounded-[1.7rem] bg-[#fffaf3] p-8"><p class="text-sm font-bold uppercase tracking-wider text-slate-500">The RoamDawn approach</p><div class="mt-5 grid gap-4 sm:grid-cols-2"><div><b class="text-xl">Destination-first</b><p class="mt-1 text-sm text-slate-600">Hubs connect broad questions to focused guides.</p></div><div><b class="text-xl">Useful detail</b><p class="mt-1 text-sm text-slate-600">Routes, timing, neighborhoods and planning trade-offs.</p></div><div><b class="text-xl">Transparent</b><p class="mt-1 text-sm text-slate-600">No invented trips, fake reviews or made-up credentials.</p></div><div><b class="text-xl">Evergreen</b><p class="mt-1 text-sm text-slate-600">Content designed to be updated as travel details change.</p></div></div></div></div></div></section>
<section class="container py-16"><div class="flex items-end justify-between gap-4"><div><p class="font-bold text-[#168ac0]">Explore</p><h2 class="text-3xl font-black">Featured destinations</h2></div><a href="/destinations/" class="font-bold text-[#168ac0]">All destinations →</a></div><div class="mt-7 grid gap-5 md:grid-cols-2 lg:grid-cols-3">{destinations.map(d=><DestinationCard name={d.name} slug={d.slug} description={d.intro} image={d.image}/>)}</div></section>
<section class="bg-white py-16"><div class="container"><p class="font-bold text-[#168ac0]">Fresh from the journal</p><h2 class="text-3xl font-black">Latest travel guides</h2><div class="mt-7 grid gap-5 md:grid-cols-2 lg:grid-cols-3">{posts.slice(0,6).map(post=><ArticleCard post={post}/>)}</div></div></section>
<section class="container py-16"><div class="rounded-3xl bg-[#18232d] p-8 text-white md:p-12"><div class="grid gap-8 md:grid-cols-2 md:items-end"><div><p class="font-bold text-orange-300">Plan with confidence</p><h2 class="mt-2 text-3xl font-black">A travel site should help you decide what to do next.</h2><p class="mt-4 max-w-2xl text-white/75">That is why RoamDawn links destination hubs to practical city guides, itineraries and planning articles rather than treating every post as an isolated story.</p></div><a href="/about/" class="justify-self-start rounded-full bg-white px-5 py-3 font-bold text-[#18232d]">Read our editorial approach</a></div></div></section>
</BaseLayout>
