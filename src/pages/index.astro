---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', { filter: ({ data }) => !data.draft }))
  .sort((a, b) => (b.data.publishDate.valueOf() - a.data.publishDate.valueOf()) || b.id.localeCompare(a.id));
const featuredPost = posts.find((post) => post.id === 'best-cities-to-visit-in-japan') || posts[0];
const latestPosts = posts.filter((post) => post.id !== featuredPost?.id).slice(0, 3);
const destinations = [
  { name: 'Japan', label: 'Seasonal guides', href: '/destinations/japan/', image: '/images/japan-travel-hero.svg' },
  { name: 'Northern Lights', label: 'Aurora planning', href: '/blog/best-time-to-visit-northern-lights/', image: '/images/destinations/northern-lights/northern-lights-guide.svg' },
];
---
<BaseLayout title="RoamDawn — Travel Guides, Destinations & Adventure" description="Practical travel guides, destination ideas and itineraries to help you plan better journeys around the world.">
  <main>
    <section class="relative overflow-hidden border-b border-sky-100 bg-[#eef9fb]">
      <div class="container grid gap-10 py-10 sm:py-14 lg:grid-cols-[1.02fr_.98fr] lg:items-center lg:py-20">
        <div class="max-w-2xl">
          <p class="text-sm font-extrabold uppercase tracking-[.2em] text-[#1388ad]">Travel better · go further</p>
          <h1 class="mt-4 text-5xl font-black leading-[.98] tracking-[-.045em] text-[#152b3b] sm:text-6xl lg:text-[5.4rem]">Plan trips worth remembering.</h1>
          <p class="mt-6 max-w-xl text-lg leading-8 text-slate-600 sm:text-xl">Destination guides, seasonal advice and practical trip-planning ideas — without the noise.</p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="/blog/" class="rounded-full bg-[#118fba] px-6 py-3.5 font-bold text-white shadow-lg shadow-sky-900/10 transition hover:-translate-y-0.5 hover:bg-[#0d7da4]">Explore travel guides</a>
            <a href="/destinations/japan/" class="rounded-full border border-slate-200 bg-white px-6 py-3.5 font-bold text-[#193142] transition hover:border-sky-200">Explore Japan</a>
          </div>
          <div class="mt-9 flex flex-wrap gap-6 text-sm font-semibold text-slate-500"><span>✓ Practical planning</span><span>✓ Seasonal guides</span><span>✓ Destination ideas</span></div>
        </div>
        <div class="relative min-h-[360px] overflow-hidden rounded-[2rem] bg-[#15364a] shadow-2xl shadow-slate-900/10">
          <img src="/images/japan-travel-hero.svg" alt="Mountain landscape representing travel and adventure" width="1200" height="675" class="absolute inset-0 h-full w-full object-cover opacity-90" />
          <div class="absolute inset-0 bg-gradient-to-t from-[#071e2b]/90 via-[#071e2b]/10 to-transparent"></div>
          <div class="absolute bottom-0 left-0 right-0 p-6 sm:p-8"><p class="text-xs font-extrabold uppercase tracking-[.18em] text-[#8ce8f4]">Start here</p><h2 class="mt-2 text-3xl font-black text-white sm:text-4xl">Know when to go. Know where to go.</h2><p class="mt-3 max-w-lg text-sm leading-6 text-white/75">Build your trip around the season, the destination and the experiences that matter to you.</p></div>
        </div>
      </div>
    </section>

    {featuredPost && <section class="container py-12 sm:py-16" aria-labelledby="featured-guide">
      <div class="mb-6 flex items-end justify-between gap-4"><div><p class="text-sm font-extrabold uppercase tracking-[.18em] text-[#1388ad]">Editor's pick</p><h2 id="featured-guide" class="mt-1 text-3xl font-black tracking-tight text-[#152b3b] sm:text-4xl">A guide to start with</h2></div><a href="/blog/" class="hidden font-bold text-[#1388ad] sm:block">All guides →</a></div>
      <ArticleCard post={featuredPost} featured={true} />
    </section>}

    <section class="border-y border-stone-200 bg-[#fbf8f2]" aria-labelledby="latest-guides">
      <div class="container py-12 sm:py-16">
        <div class="flex items-end justify-between gap-4"><div><p class="text-sm font-extrabold uppercase tracking-[.18em] text-[#1388ad]">Fresh from RoamDawn</p><h2 id="latest-guides" class="mt-1 text-3xl font-black tracking-tight text-[#152b3b] sm:text-4xl">Latest travel guides</h2></div><a href="/blog/" class="font-bold text-[#1388ad]">View all →</a></div>
        <div class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-3">{latestPosts.map((post) => <ArticleCard post={post} />)}</div>
      </div>
    </section>

    <section class="container py-12 sm:py-16" aria-labelledby="destinations-heading">
      <div><p class="text-sm font-extrabold uppercase tracking-[.18em] text-[#1388ad]">Choose your next escape</p><h2 id="destinations-heading" class="mt-1 text-3xl font-black tracking-tight text-[#152b3b] sm:text-4xl">Explore by destination</h2></div>
      <div class="mt-8 grid gap-6 md:grid-cols-2">{destinations.map((destination) => <a href={destination.href} class="group relative min-h-[260px] overflow-hidden rounded-[1.75rem] bg-[#15364a] shadow-sm transition hover:-translate-y-1 hover:shadow-xl"><img src={destination.image} alt={destination.name} width="1200" height="675" class="absolute inset-0 h-full w-full object-cover opacity-80 transition duration-700 group-hover:scale-105" loading="lazy" /><div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/10 to-transparent"></div><div class="absolute bottom-0 p-7"><p class="text-xs font-extrabold uppercase tracking-[.18em] text-[#9beaf2]">{destination.label}</p><h3 class="mt-2 text-3xl font-black text-white">{destination.name}</h3><span class="mt-3 inline-block font-bold text-white/90">Explore guide →</span></div></a>)}</div>
    </section>

    <section class="container pb-16 sm:pb-20"><div class="relative overflow-hidden rounded-[2rem] bg-[#17384b] px-7 py-10 text-white sm:px-12 sm:py-12"><div class="absolute -right-16 -top-20 h-48 w-48 rounded-full bg-[#f7b955]/20"></div><div class="relative max-w-2xl"><p class="text-sm font-extrabold uppercase tracking-[.18em] text-[#8ce8f4]">Travel planning, simplified</p><h2 class="mt-3 text-3xl font-black sm:text-4xl">Find the right season, destination and route.</h2><p class="mt-4 leading-7 text-white/70">RoamDawn focuses on useful travel information you can actually use when building your next trip.</p><a href="/blog/" class="mt-7 inline-flex rounded-full bg-white px-6 py-3 font-bold text-[#17384b] transition hover:bg-sky-50">Browse all guides →</a></div></div></section>
  </main>
</BaseLayout>
