---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', { filter: ({ data }) => !data.draft }))
  .sort((a, b) => (b.data.publishDate.valueOf() - a.data.publishDate.valueOf()) || b.id.localeCompare(a.id));

const imageFor = (post) => {
  const special: Record<string, string> = {
    'best-cities-to-visit-in-japan': '/images/destinations/japan/best-cities-to-visit-in-japan-tokyo-japan-travel-skyline.webp',
    'best-time-to-visit-japan': '/images/destinations/japan/best-time-to-visit-japan-japan-autumn-travel-landscape.webp',
  };
  return special[post.id] || post.data.featuredImage || '/images/og-default.svg';
};
---

<BaseLayout title="RoamDawn — Travel Guides & Stories" description="Practical travel guides, destination ideas and stories to help you plan your next trip.">
  <main class="home">
    <div class="home-container">
      <div class="post-grid">
        {posts.map((post) => (
          <article class="post">
            <a class="post-image" href={`/blog/${post.id}/`}>
              <img src={imageFor(post)} alt={post.data.title} width="900" height="580" loading="lazy" />
            </a>
            <div class="post-body">
              <p class="label">{post.data.category} · {post.data.readingTime} min read</p>
              <h2><a href={`/blog/${post.id}/`}>{post.data.title}</a></h2>
              <p class="description">{post.data.description}</p>
              <a class="read-link" href={`/blog/${post.id}/`}>Read more →</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .home { background: #fff; color: #1d292f; }
  .home-container { width: min(1120px, calc(100% - 52px)); margin: 0 auto; padding: 44px 0 80px; }
  .post-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 38px; row-gap: 54px; }
  .post { min-width: 0; }
  .post-image { display: block; width: 100%; aspect-ratio: 1.56; overflow: hidden; background: #eee; }
  .post-image img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .post-body { padding-top: 20px; }
  .label { margin: 0 0 14px; color: #287c8b; font-size: .74rem; font-weight: 700; letter-spacing: .09em; text-transform: uppercase; line-height: 1.4; }
  .post h2 { margin: 0 0 17px; font-size: clamp(1.75rem, 2.6vw, 2.25rem); font-weight: 400; line-height: 1.16; letter-spacing: -.035em; }
  .post h2 a { color: #202b30; text-decoration: none; }
  .post h2 a:hover { color: #287c8b; }
  .description { margin: 0; max-width: 540px; color: #788186; font-size: 1rem; line-height: 1.75; }
  .read-link { display: inline-block; margin-top: 17px; color: #287c8b; font-size: .86rem; font-weight: 700; text-decoration: none; }
  .read-link:hover { text-decoration: underline; }

  @media (max-width: 700px) {
    .home-container { width: calc(100% - 28px); padding: 28px 0 55px; }
    .post-grid { grid-template-columns: 1fr; row-gap: 44px; }
    .post h2 { font-size: 1.65rem; }
    .description { font-size: .94rem; }
  }
</style>
