---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getCollection } from 'astro:content';
const posts = (await getCollection('blog', { filter: ({ data }) => !data.draft }))
  .sort((a, b) => (b.data.publishDate.valueOf() - a.data.publishDate.valueOf()) || b.id.localeCompare(a.id));
const priorityPost = posts.find((post) => post.id === 'best-time-to-visit-japan');
const latestPosts = priorityPost
  ? [priorityPost, ...posts.filter((post) => post.id !== priorityPost.id).slice(0, 1)]
  : posts.slice(0, 2);
---
<BaseLayout title="RoamDawn — Travel Guides, Destinations & Adventure" description="Practical travel guides, destination ideas and itineraries to help you plan better journeys around the world.">
  <section class="bg-[#f4fbfd] border-b border-sky-100"><div class="container grid gap-10 py-14 md:grid-cols-[1.05fr_.95fr] md:items-center md:py-20"><div><p class="font-bold uppercase tracking-[.18em] text-[#1596c2]">Travel guides & inspiration</p><h1 class="mt-4 max-w-4xl text-5xl font-black leading-[1.02] tracking-tight text-[#17324d] sm:text-7xl">Discover your next journey.</h1><p class="mt-6 max-w-2xl text-lg leading-8 text-slate-600">Practical destination guides, itineraries and travel planning advice to help you travel with confidence.</p><div class="mt-8 flex flex-wrap gap-3"><a class="rounded-full bg-[#1596c2] px-6 py-3 font-bold text-white shadow-sm hover:bg-[#117fa5]" href="/blog/best-time-to-visit-japan/">Read the Japan Guide</a><a class="rounded-full border border-sky-200 bg-white px-6 py-3 font-bold text-[#17324d] hover:bg-sky-50" href="/blog/">Read Travel Guides</a></div></div><div class="relative overflow-hidden rounded-[2rem] border border-sky-100 bg-white p-7 shadow-sm"><div class="absolute right-0 top-0 h-24 w-24 rounded-bl-full bg-[#fff0c9]" aria-hidden="true"></div><p class="relative text-sm font-bold uppercase tracking-wider text-[#1596c2]">Plan smarter</p><h2 class="relative mt-3 text-3xl font-black text-[#17324d]">From inspiration to itinerary.</h2><div class="relative mt-7 grid gap-3 sm:grid-cols-2"><div class="rounded-2xl bg-[#f4fbfd] p-4"><b class="text-lg text-[#17324d]">01 · Discover</b><p class="mt-1 text-sm text-slate-600">Find destinations worth exploring.</p></div><div class="rounded-2xl bg-[#fff8e8] p-4"><b class="text-lg text-[#17324d]">02 · Compare</b><p class="mt-1 text-sm text-slate-600">Choose the right season and route.</p></div><div class="rounded-2xl bg-[#eef9f2] p-4"><b class="text-lg text-[#17324d]">03 · Plan</b><p class="mt-1 text-sm text-slate-600">Build a realistic travel itinerary.</p></div><div class="rounded-2xl bg-[#fff3ed] p-4"><b class="text-lg text-[#17324d]">04 · Go</b><p class="mt-1 text-sm text-slate-600">Travel prepared and enjoy the journey.</p></div></div></div></div></section>

<section class="container py-12" aria-labelledby="latest-guides"><div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between"><div><p class="font-bold text-[#1596c2]">New on RoamDawn</p><h2 id="latest-guides" class="text-3xl font-black text-[#17324d]">Latest Japan travel guides</h2></div><a class="font-bold text-[#1596c2] hover:underline" href="/blog/">View all →</a></div><div class="mt-7 grid gap-6 md:grid-cols-2">{latestPosts.map((post, index) => <ArticleCard post={post} featured={index === 0} />)}</div></section>

<section class="container py-16"><div class="rounded-3xl border border-sky-100 bg-[#f4fbfd] p-8 md:p-12"><div class="grid gap-8 md:grid-cols-[1fr_auto] md:items-center"><div><p class="font-bold text-[#1596c2]">Travel with confidence</p><h2 class="mt-2 text-3xl font-black text-[#17324d]">Useful ideas for your next adventure.</h2><p class="mt-4 max-w-2xl leading-7 text-slate-600">RoamDawn is starting fresh with practical, focused travel guides designed to help you plan better journeys.</p></div><a href="/destinations/japan/" class="inline-flex w-fit rounded-full bg-[#1596c2] px-5 py-3 font-bold text-white hover:bg-[#117fa5]">Explore Japan →</a></div></div></section>
</BaseLayout>
