---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import DestinationCard from '../components/DestinationCard.astro';
import { getCollection } from 'astro:content';
import { destinations } from '../data/destinations';
const posts=(await getCollection('blog',{filter:({data})=>!data.draft})).sort((a,b)=>b.data.publishDate.valueOf()-a.data.publishDate.valueOf());
---
<BaseLayout title="RoamDawn — Travel Guides, Destinations & Adventure" description="Practical travel guides, destination ideas and itineraries to help you plan better journeys around the world.">
<section class="bg-[#f4fbfd] border-b border-sky-100"><div class="container grid gap-10 py-14 md:grid-cols-[1.05fr_.95fr] md:items-center md:py-20"><div><p class="font-bold uppercase tracking-[.18em] text-[#1596c2]">Travel guides & inspiration</p><h1 class="mt-4 max-w-4xl text-5xl font-black leading-[1.02] tracking-tight text-[#17324d] sm:text-7xl">Discover your next journey.</h1><p class="mt-6 max-w-2xl text-lg leading-8 text-slate-600">Practical destination guides, itineraries and travel planning advice to help you travel with confidence.</p><div class="mt-8 flex flex-wrap gap-3"><a class="rounded-full bg-[#1596c2] px-6 py-3 font-bold text-white shadow-sm hover:bg-[#117fa5]" href="/destinations/">Explore Destinations</a><a class="rounded-full border border-sky-200 bg-white px-6 py-3 font-bold text-[#17324d] hover:bg-sky-50" href="/blog/">Read Travel Guides</a></div></div><div class="relative overflow-hidden rounded-[2rem] border border-sky-100 bg-white p-7 shadow-sm"><div class="absolute right-0 top-0 h-24 w-24 rounded-bl-full bg-[#fff0c9]" aria-hidden="true"></div><p class="relative text-sm font-bold uppercase tracking-wider text-[#1596c2]">Plan smarter</p><h2 class="relative mt-3 text-3xl font-black text-[#17324d]">From inspiration to itinerary.</h2><div class="relative mt-7 grid gap-3 sm:grid-cols-2"><div class="rounded-2xl bg-[#f4fbfd] p-4"><b class="text-lg text-[#17324d]">01 · Discover</b><p class="mt-1 text-sm text-slate-600">Find destinations worth exploring.</p></div><div class="rounded-2xl bg-[#fff8e8] p-4"><b class="text-lg text-[#17324d]">02 · Compare</b><p class="mt-1 text-sm text-slate-600">Choose the right season and route.</p></div><div class="rounded-2xl bg-[#eef9f2] p-4"><b class="text-lg text-[#17324d]">03 · Plan</b><p class="mt-1 text-sm text-slate-600">Build a realistic travel itinerary.</p></div><div class="rounded-2xl bg-[#fff3ed] p-4"><b class="text-lg text-[#17324d]">04 · Go</b><p class="mt-1 text-sm text-slate-600">Travel prepared and enjoy the journey.</p></div></div></div></div></section>
<section class="container py-16"><div class="flex items-end justify-between gap-4"><div><p class="font-bold text-[#1596c2]">Where to next?</p><h2 class="text-3xl font-black text-[#17324d]">Featured destinations</h2></div><a href="/destinations/" class="font-bold text-[#1596c2]">View all →</a></div><div class="mt-7 grid gap-5 md:grid-cols-2 lg:grid-cols-3">{destinations.map(d=><DestinationCard name={d.name} slug={d.slug} description={d.intro} image={d.image}/>)}</div></section>
<section class="bg-[#fffaf0] py-16"><div class="container"><p class="font-bold text-[#1596c2]">Fresh from the journal</p><h2 class="text-3xl font-black text-[#17324d]">Latest travel guides</h2><div class="mt-7 grid gap-5 md:grid-cols-2 lg:grid-cols-3">{posts.slice(0,6).map(post=><ArticleCard post={post}/>)}</div></div></section>
<section class="container py-16"><div class="rounded-3xl bg-[#17324d] p-8 text-white md:p-12"><div class="grid gap-8 md:grid-cols-2 md:items-end"><div><p class="font-bold text-[#ffd36a]">Travel with confidence</p><h2 class="mt-2 text-3xl font-black">Useful ideas for your next adventure.</h2><p class="mt-4 max-w-2xl text-white/75">RoamDawn connects destination hubs with practical city guides, itineraries and planning articles so you can decide what to do next.</p></div><a href="/about/" class="justify-self-start rounded-full bg-white px-5 py-3 font-bold text-[#17324d] hover:bg-[#fff8e8]">Our editorial approach</a></div></div></section>
</BaseLayout>
