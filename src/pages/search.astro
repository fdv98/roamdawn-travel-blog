---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
const posts = await getCollection('blog', { filter: ({ data }) => !data.draft });
const index = posts.map((p) => ({
  title: p.data.title,
  description: p.data.description,
  category: p.data.category,
  tags: p.data.tags ?? [],
  keywords: p.data.keywords ?? [],
  url: `/blog/${p.id}/`,
}));
---
<BaseLayout title="Search Travel Guides | RoamDawn" description="Search RoamDawn travel guides by title, description, destination, tags and keywords.">
  <section class="container py-12 sm:py-16">
    <div class="mx-auto max-w-4xl">
      <p class="text-sm font-bold uppercase tracking-[.18em] text-[#1596c2]">Travel library</p>
      <h1 class="mt-2 text-4xl font-black tracking-tight text-[#17324d] sm:text-5xl">Find your travel guide</h1>
      <p class="mt-4 max-w-2xl text-lg leading-8 text-slate-600">Search destinations, city guides, itineraries and planning advice.</p>

      <form id="search-form" class="mt-8 flex gap-3" role="search">
        <label class="min-w-0 flex-1">
          <span class="sr-only">Search travel guides</span>
          <input id="search" name="q" type="search" autocomplete="off" class="w-full rounded-2xl border border-sky-200 bg-white px-5 py-4 text-lg text-[#17324d] outline-none transition focus:border-[#1596c2] focus:ring-4 focus:ring-sky-100" placeholder="Try Japan, Kyoto, fjords or itinerary…" />
        </label>
        <button type="submit" class="shrink-0 rounded-2xl bg-[#1596c2] px-6 py-4 font-bold text-white hover:bg-[#117fa5]">Search</button>
      </form>

      <p id="count" class="mt-4 text-sm text-slate-500" aria-live="polite"></p>
      <div id="results" class="mt-7 grid gap-5 md:grid-cols-2"></div>
    </div>
  </section>

  <script define:vars={{ index }}>
    const input = document.getElementById('search');
    const form = document.getElementById('search-form');
    const results = document.getElementById('results');
    const count = document.getElementById('count');

    const normalize = (value) => String(value ?? '').toLocaleLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
    const searchable = (item) => [item.title, item.description, item.category, ...(item.tags || []), ...(item.keywords || [])].map(normalize).join(' ');

    function render(query = input.value) {
      const q = normalize(query).trim();
      if (!q) {
        count.textContent = '';
        results.replaceChildren();
        return;
      }

      const terms = q.split(/\s+/).filter(Boolean);
      const hits = index.filter((item) => {
        const text = searchable(item);
        return terms.every((term) => text.includes(term));
      });

      count.textContent = `${hits.length} ${hits.length === 1 ? 'result' : 'results'}`;
      results.replaceChildren();

      if (!hits.length) {
        const empty = document.createElement('p');
        empty.className = 'rounded-2xl border border-slate-200 bg-white p-6 text-slate-600';
        empty.textContent = 'No travel guides matched your search.';
        results.append(empty);
        return;
      }

      hits.forEach((item) => {
        const article = document.createElement('article');
        article.className = 'rounded-2xl border border-sky-100 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md';

        const category = document.createElement('p');
        category.className = 'text-xs font-bold uppercase tracking-wider text-[#1596c2]';
        category.textContent = item.category;

        const heading = document.createElement('h2');
        heading.className = 'mt-1 text-xl font-black text-[#17324d]';
        const link = document.createElement('a');
        link.href = item.url;
        link.textContent = item.title;
        heading.append(link);

        const description = document.createElement('p');
        description.className = 'mt-2 text-sm leading-6 text-slate-600';
        description.textContent = item.description;

        article.append(category, heading, description);
        results.append(article);
      });
    }

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      render();
      const url = new URL(window.location.href);
      const value = input.value.trim();
      value ? url.searchParams.set('q', value) : url.searchParams.delete('q');
      window.history.replaceState({}, '', url);
    });

    input.addEventListener('input', () => render());

    const initialQuery = new URLSearchParams(window.location.search).get('q');
    if (initialQuery) input.value = initialQuery;
    render(initialQuery || '');
  </script>
</BaseLayout>
