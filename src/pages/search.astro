---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
const posts=await getCollection('blog',{filter:({data})=>!data.draft});
const index=posts.map(p=>({title:p.data.title,description:p.data.description,category:p.data.category,tags:p.data.tags,keywords:p.data.keywords,url:`/blog/${p.id}/`}));
---
<BaseLayout title="Search Travel Guides | RoamDawn" description="Search RoamDawn travel guides by title, description, destination, tags and keywords."><section class="container py-14"><h1 class="text-5xl font-black">Search RoamDawn</h1><label class="mt-8 block"><span class="sr-only">Search travel guides</span><input id="search" type="search" class="w-full rounded-2xl border bg-white px-5 py-4 text-lg" placeholder="Try Japan, Kyoto, fjords or itinerary…"/></label><p id="count" class="mt-4 text-sm text-slate-500"></p><div id="results" class="mt-7 grid gap-5 md:grid-cols-2"></div></section><script define:vars={{index}}>{`const input=document.getElementById('search'),results=document.getElementById('results'),count=document.getElementById('count');function render(){const q=input.value.trim().toLowerCase();const hits=index.filter(x=>[x.title,x.description,x.category,...x.tags,...x.keywords].join(' ').toLowerCase().includes(q));count.textContent=q?\`${hits.length} result${hits.length===1?'':'s'}\`:'';results.innerHTML=hits.map(x=>\`<article class="rounded-2xl border bg-white p-5"><p class="text-xs font-bold uppercase text-[#168ac0]">${x.category}</p><h2 class="mt-1 text-xl font-black"><a href="${x.url}">${x.title}</a></h2><p class="mt-2 text-sm text-slate-600">${x.description}</p></article>\`).join('')||(q?'<p class="text-slate-600">No guides matched your search.</p>':'')}input.addEventListener('input',render);render();`}</script></BaseLayout>