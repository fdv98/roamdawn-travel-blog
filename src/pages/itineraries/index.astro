---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getCollection } from 'astro:content';
const posts = (await getCollection('blog', { filter: ({ data }) => !data.draft && data.tags.some((tag) => /itinerary|travel planning/i.test(tag)) }))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
---
<BaseLayout title="Japan Trip Planning Guides | RoamDawn" description="Plan a Japan trip with practical guides covering the best time to visit, city choices, seasons and realistic itineraries." breadcrumbs={[{ label: 'Itineraries', href: '/itineraries/' }]}>
  <section class="container py-14 md:py-16">
    <p class="font-bold uppercase tracking-wider text-[#168ac0]">Japan trip planning</p>
    <h1 class="mt-2 text-5xl font-black tracking-tight text-[#17324d] sm:text-6xl">Plan Your Japan Trip</h1>
    <p class="mt-5 max-w-3xl text-lg leading-8 text-slate-600">Start with the season, choose the right cities, then build a route that leaves enough time to actually enjoy each stop.</p>
    <div class="mt-8 grid gap-4 rounded-2xl border border-sky-100 bg-white p-5 sm:grid-cols-3">
      <div><b class="text-slate-900">Choose your dates</b><p class="mt-1 text-sm text-slate-600">Compare spring, summer, autumn and winter conditions.</p></div>
      <div><b class="text-slate-900">Choose your cities</b><p class="mt-1 text-sm text-slate-600">Match Tokyo, Kyoto, Osaka and other cities to your travel style.</p></div>
      <div><b class="text-slate-900">Build a realistic route</b><p class="mt-1 text-sm text-slate-600">Leave room for transport, rest and changes in weather.</p></div>
    </div>
    <div class="mt-10 grid gap-6 md:grid-cols-2">
      {posts.map((post) => <ArticleCard post={post} />)}
    </div>
    {posts.length === 0 && <div class="mt-10 rounded-2xl border border-stone-200 bg-white p-8 text-center text-slate-600">More Japan trip-planning guides are coming soon.</div>}
  </section>
</BaseLayout>
