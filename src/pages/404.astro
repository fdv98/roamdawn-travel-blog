---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="404 — RoamDawn" description="The page you requested could not be found.">
  <section class="container py-24 text-center">
    <p class="font-bold text-[#168ac0]">404</p>
    <h1 class="mt-2 text-5xl font-black text-[#17324d]">Looks like this journey took a wrong turn.</h1>
    <p class="mx-auto mt-5 max-w-xl text-slate-600">The page may have moved or the address may be incorrect.</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a class="rounded-full bg-[#1596c2] px-5 py-3 font-bold text-white hover:bg-[#117fa5]" href="/">Home</a>
      <a class="rounded-full border border-sky-200 bg-white px-5 py-3 font-bold text-[#17324d] hover:bg-sky-50" href="/destinations/">Destinations</a>
      <a class="rounded-full border border-sky-200 bg-white px-5 py-3 font-bold text-[#17324d] hover:bg-sky-50" href="/blog/">Latest guides</a>
      <a class="rounded-full border border-sky-200 bg-white px-5 py-3 font-bold text-[#17324d] hover:bg-sky-50" href="/search/">Search</a>
    </div>
  </section>
</BaseLayout>
